From: Marty Jones <mj8263788@gmail.com>
Date: Mon, 16 Nov 2026 17:51:11 -0300
Subject: [PATCH] add more boards

Signed-off-by: Marty Jones <mj8263788@gmail.com>
---
 package/boot/uboot-rockchip/Makefile          |  47 +++++++
 ...9-rockchip-add-add-Hugsun-X99-TV-Box.patch | 124 ++++++++++++++++++
 2 files changed, 171 insertions(+)
 create mode 100644 package/boot/uboot-rockchip/patches/099-rockchip-add-add-Hugsun-X99-TV-Box.patch

diff --git a/package/boot/uboot-rockchip/Makefile b/package/boot/uboot-rockchip/Makefile
index c780545fd4..5e66713003 100644
--- a/package/boot/uboot-rockchip/Makefile
+++ b/package/boot/uboot-rockchip/Makefile
@@ -128,6 +128,14 @@ define U-Boot/rk3399/Default
   ATF:=rk3399_bl31.elf
 endef
 
+define U-Boot/hugsun-x99-rk3399
+  $(U-Boot/rk3399/Default)
+  NAME:=Hugsun x99
+  DEFAULT := y
+  BUILD_DEVICES:= \
+    hugsun_hugsun-x99
+endef
+
 define U-Boot/nanopc-t4-rk3399
   $(U-Boot/rk3399/Default)
   NAME:=NanoPC T4
@@ -135,6 +143,32 @@ define U-Boot/nanopc-t4-rk3399
     friendlyarm_nanopc-t4
 endef
 
+define U-Boot/nanopi-m4-rk3399
+  $(U-Boot/rk3399/Default)
+  NAME:=NanoPi M4
+  DEFAULT := y
+  BUILD_DEVICES:= \
+    friendlyarm_nanopi-m4
+endef
+
+define U-Boot/nanopi-m4-2gb-rk3399
+  $(U-Boot/rk3399/Default)
+  NAME:=NanoPi M4 2GB
+  DEFAULT := y
+  BUILD_DEVICES:= \
+    friendlyarm_nanopi-m4-2gb
+endef
+
+define U-Boot/nanopi-m4v2-rk3399
+  $(U-Boot/rk3399/Default)
+  NAME:=NanoPi m4v2
+  DEFAULT := y
+  BUILD_DEVICES:= \
+    friendlyarm_nanopi-m4v2
+  UBOOT_DTS:=rk3399-nanopi-m4.dts
+  UBOOT_CONFIG:=roc-pc-rk3399
+endef
+
 define U-Boot/nanopi-r4s-rk3399
   $(U-Boot/rk3399/Default)
   NAME:=NanoPi R4S
@@ -407,6 +441,14 @@ define U-Boot/sige7-rk3588
     armsom_sige7
 endef
 
+define U-Boot/orangepi-5-plus-rk3588
+  $(U-Boot/rk358x/Default)
+  NAME:=ORANGEPI-5-PLUS
+  DEFAULT := y
+  BUILD_DEVICES:= \
+    xunlong_orangepi-5-plus
+endef
+
 
 # RK3588S boards
 
@@ -439,7 +481,11 @@ define U-Boot/rock-5c-rk3588s
 endef
 
 UBOOT_TARGETS := \
+  hugsun-x99-rk3399 \
   nanopc-t4-rk3399 \
+  nanopi-m4-rk3399 \
+  nanopi-m4-2gb-rk3399 \
+  nanopi-m4v2-rk3399 \
   nanopi-r4s-rk3399 \
   rock-4c-plus-rk3399 \
   rock-4se-rk3399 \
@@ -481,6 +527,7 @@ UBOOT_TARGETS := \
   rock-5-itx-rk3588 \
   rock5b-rk3588 \
   sige7-rk3588 \
+  orangepi-5-plus-rk3588 \
   nanopi-r6c-rk3588s \
   nanopi-r6s-rk3588s \
   rock5a-rk3588s \
diff --git a/package/boot/uboot-rockchip/patches/099-rockchip-add-add-Hugsun-X99-TV-Box.patch b/package/boot/uboot-rockchip/patches/099-rockchip-add-add-Hugsun-X99-TV-Box.patch
